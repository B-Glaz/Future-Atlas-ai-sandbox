# OpenRouter. Keep the key server-side only.
# The app tries the free flash model first, then the next free model if it stalls.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
AI_ENABLED=true
# Optional comma-separated kill switch, for example: cost,scholarship
AI_DISABLED_MODES=

# Supabase public browser configuration. Publishable key is safe for clients;
# RLS and server-side user validation protect private data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public Google OAuth web client ID used by Google Identity Services.
# Keep the Google client secret only in Supabase Auth provider settings.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=508514149239-s8ubgbr7ikf871vc88t3va7r6b7cmca4.apps.googleusercontent.com

# Server-only Supabase secret key. Never use a NEXT_PUBLIC_ name for this.
SUPABASE_SECRET_KEY=

# Server-only secret used to sign API access and refresh tokens.
# At least 32 characters. Do not reuse the Supabase secret key.
API_TOKEN_SIGNING_SECRET=
SUPABASE_JWKS_URL=

# Optional forum destination. Falls back to the internal guidance page.
NEXT_PUBLIC_FORUM_URL=

# Comma-separated exact origins allowed to embed /embed.
# Include the scheme and do not include paths.
EMBED_ALLOWED_ORIGINS=https://client.com

# Optional alert recipient metadata for security notifications.
SECURITY_ALERT_EMAIL=

# Optional webhook endpoint that receives unauthorized-embed alerts as JSON.
SECURITY_ALERT_WEBHOOK_URL=

# Optional alert cooldown. Defaults to 3600 seconds.
SECURITY_ALERT_COOLDOWN_SECONDS=3600
