{
  "name": "future-atlas-ai-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/cloudflare-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --no-warnings --experimental-strip-types scripts/check-structured-output.mjs && node --no-warnings --experimental-strip-types scripts/check-provider-fallback.mjs",
    "sandbox:api-key": "node --no-warnings --experimental-strip-types scripts/sandbox-api-key.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.3.32",
    "@supabase/server": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.27.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.131.2"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
